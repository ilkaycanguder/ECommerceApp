{
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-must-be-at-least-32-characters",
    "Issuer": "ECommerceApp.Auth",
    "Audience": "ECommerceApp",
    "ExpiryMinutes": "60"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "log-route": {
        "ClusterId": "log-cluster",
        "Match": {
          "Path": "/api/logs/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7044"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7120"
          }
        }
      },
      "log-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7273"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}